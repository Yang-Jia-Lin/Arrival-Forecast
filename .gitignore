# Large downloaded and event-level data
/Data/Raw/**
/Data/Interim/**
!/Data/Raw/.gitkeep
!/Data/Interim/.gitkeep

# Generated local logs and archived output copies
/Outputs/Logs/
/Outputs/Tables/archive/

# Virtual environments
.venv/
venv/
env/

# Python caches, tests, coverage, and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Notebook checkpoints
.ipynb_checkpoints/

# Model artifacts
*.pth
*.pt
*.h5
*.ckpt
*.safetensors
*.mnn
*.onnx
*.onnx.data

# Local configuration and secrets
.env
.env.*
!.env.example
.vscode/
.idea/
.agents/
.codex/

# Temporary files and downloads
*.part
*.tmp
*.temp
*.log
*.bak
*.swp
*~

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Recoverable migration backups
/archive/
